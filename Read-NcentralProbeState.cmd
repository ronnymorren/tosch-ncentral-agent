@echo off
rem Read-only probe inspection. Literal commands; no PS1, policy changes, downloads or installation.
setlocal DisableDelayedExpansion
set "NCP_COMPUTER=%~1"
set "NCP_SERIAL=%~2"
set "NCP_APPLIANCE=%~3"
if not defined NCP_COMPUTER goto failed
if not defined NCP_SERIAL goto failed
if not defined NCP_APPLIANCE goto failed
powershell.exe -NoProfile -Command "$ErrorActionPreference='Stop';try{if($env:COMPUTERNAME -ine $env:NCP_COMPUTER){throw 'Computer'};$serial=(Get-CimInstance Win32_BIOS).SerialNumber.Trim();if($serial -ne $env:NCP_SERIAL -or $env:NCP_APPLIANCE -notmatch '^\d+$'){throw 'Identity'};$main=Get-CimInstance Win32_Service|Where-Object {$_.Name -eq 'Windows Software Probe Service'};if(!$main){throw 'Probe missing'};$image=([string]$main.PathName).Trim();$end=$image.IndexOf('.exe',[StringComparison]::OrdinalIgnoreCase);if($end -lt 0){throw 'Executable'};$exe=[IO.Path]::GetFullPath($image.Substring(0,$end+4).Trim([char]34));$root=[IO.Path]::GetFullPath((Join-Path ${env:ProgramFiles(x86)} 'N-able Technologies\Windows Software Probe')).TrimEnd('\')+'\';if(!$exe.StartsWith($root,[StringComparison]::OrdinalIgnoreCase)){throw 'Location'};$f=Get-Item -LiteralPath $exe;if($f.Attributes -band [IO.FileAttributes]::ReparsePoint){throw 'Reparse'};$version=$f.VersionInfo.FileVersion.Trim();if($version -notmatch '^\d+(\.\d+){3}$'){throw 'Version'};$config=Join-Path $root 'config\ApplianceConfig.xml';if((Get-Item -LiteralPath $config).Attributes -band [IO.FileAttributes]::ReparsePoint){throw 'Config reparse'};$xs=[Xml.XmlReaderSettings]::new();$xs.DtdProcessing=[Xml.DtdProcessing]::Prohibit;$xs.XmlResolver=$null;$xr=[Xml.XmlReader]::Create($config,$xs);try{$xml=[Xml.XmlDocument]::new();$xml.XmlResolver=$null;$xml.Load($xr)}finally{$xr.Dispose()};$nodes=@($xml.SelectNodes('//*')|Where-Object {$_.LocalName -ieq 'ApplianceID'});if($nodes.Count -ne 1){throw 'Probe identity missing'};$id=$nodes[0].InnerText.Trim();if($id -ne $env:NCP_APPLIANCE){throw 'Probe identity mismatch'};$definitions=@(@{Role='Probe';Name='Windows Software Probe Service'},@{Role='Maintenance';Name='Windows Software Probe Maintenance Service'},@{Role='Syslog';Name='Windows Software Probe Syslog Service'});$services=@(foreach($def in $definitions){$svc=Get-Service -Name $def.Name;[pscustomobject]@{Role=$def.Role;Name=$def.Name;State=[string]$svc.Status;StartType=[string]$svc.StartType}});[pscustomobject][ordered]@{ObservedUtc=(Get-Date).ToUniversalTime().ToString('o');Status='ReadOnlyVerified';Computer=$env:COMPUTERNAME;Serial=$serial;BootUtc=(Get-CimInstance Win32_OperatingSystem).LastBootUpTime.ToUniversalTime().ToString('o');ProbeVersion=$version;ProbeApplianceID=$id;ProbeIdentityVerified=$true;IdentitySource='config\ApplianceConfig.xml';Executable=$exe;Services=$services}|ConvertTo-Json -Depth 5 -Compress;exit 0}catch{[pscustomobject][ordered]@{ObservedUtc=(Get-Date).ToUniversalTime().ToString('o');Status='Failed';Reason='Read-only probe identity/version/service check failed. No configuration values disclosed or changes made.'}|ConvertTo-Json -Compress;exit 1}"
set "RC=%ERRORLEVEL%"
endlocal & exit /b %RC%
:failed
echo {"Status":"Failed","Reason":"Expected identity arguments missing."}
endlocal & exit /b 1
